OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-6
# Other current Claude API IDs usable with --models:
#   claude-opus-4-8
#   claude-fable-5
#   claude-haiku-4-5

# Optional provider overrides. If omitted, models beginning with claude- use Anthropic automatically.
CLOUSEAU_LLM_PROVIDER=
CLOUSEAU_JUDGE_PROVIDER=

# Optional manual price settings for cost tracking.
# Units: USD per 1M tokens.
CLOUSEAU_INPUT_PRICE_PER_1M=
CLOUSEAU_OUTPUT_PRICE_PER_1M=
CLOUSEAU_CACHED_INPUT_PRICE_PER_1M=
ANTHROPIC_INPUT_PRICE_PER_1M=
ANTHROPIC_OUTPUT_PRICE_PER_1M=
ANTHROPIC_CACHED_INPUT_PRICE_PER_1M=
OPENAI_INPUT_PRICE_PER_1M=
OPENAI_OUTPUT_PRICE_PER_1M=
OPENAI_CACHED_INPUT_PRICE_PER_1M=
